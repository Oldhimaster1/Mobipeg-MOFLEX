      * slow software path that crawls (~1-3 FPS) and eventually crashes.  The
      * layout byte = (ImageLayout & 0xF) | (ImageRotation << 4).  ImageLayout:
      * 0/1 Interleave3D L/R-first, 2/3 TopToBottom3D, 4/5 SideBySide3D, 6 Simple2D.
-     * 3DS stereoscopic 3D is a SINGLE video stream whose frames pack both eyes
-     * per this layout (NOT two video chunks — the player renders only the first
-     * chunk).  Set -mo_layout 4 with a side-by-side packed frame for L/R 3D. */
+     * Stereo video is a SINGLE stream; retail interleaved-3D uses layout0,
+     * alternating left/right coded 400x224 frames at twice the display FPS.
+     * Layout4 side-by-side encoding previously failed a user's Old 3DS test.
+     * V5 uses -mo_interleave_input_double_rate 1 to write the half-rate
+     * display descriptor while preserving the coded packet count and PTS. */
     for (int v = 0; v < m->nb_video; v++) {
         AVStream *st = s->streams[m->video_in[v]];
         put_var(pb, 3);
         put_var(pb, 13);
         avio_w8(pb, v);                  /* EP stream index = order in list */
         avio_w8(pb, 0); /* 0 = MobiClip codec */
-        avio_wb16(pb, m->vfr.num);   /* fps numerator */
-        avio_wb16(pb, m->vfr.den);   /* fps denominator */
+        /* Retail's interleaved 3D descriptor uses frame-PAIR rate, e.g. 24/1,
+         * even though coded left/right eye packets arrive at 48/1. Do not
+         * rewrite PTS or divide frame count: this affects descriptor only. */
+        int vnum = m->vfr.num;
+        int vden = m->vfr.den;
+        int layout = v == 0 ? m->mo_layout : m->mo_layout2;
+        if (m->mo_interleave_input_double_rate && (layout == 0 || layout == 1))
+            av_reduce(&vnum, &vden, m->vfr.num,
+                      (int64_t)m->vfr.den * 2, 65535);
+        avio_wb16(pb, vnum);   /* displayed stereo FPS */
+        avio_wb16(pb, vden);
         avio_wb16(pb, st->codecpar->width);
         avio_wb16(pb, st->codecpar->height);
         avio_w8(pb, 1); /* PelRatioRate  */
