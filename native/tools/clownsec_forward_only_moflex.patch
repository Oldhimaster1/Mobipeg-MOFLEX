diff --git a/decoder/moflex_demux.c b/decoder/moflex_demux.c
--- a/decoder/moflex_demux.c
+++ b/decoder/moflex_demux.c
@@ -7,8 +7,10 @@
 
 /* ---- buffered byte reader (mirrors avio_* used by moflex.c) ---- */
 static void io_fill(MfxDemux *m) {
-    m->rbase = (int64_t)ftello(m->f) - m->base;      /* logical pos within [base, base+file_size) */
-    int toread = MFX_RBUF;
+    int64_t physical_pos = (int64_t)ftello(m->f);
+    /* Pipes have no ftello(). Keep an explicit consumed-bytes cursor in live mode. */
+    m->rbase = physical_pos >= 0 ? physical_pos - m->base : m->rbase + m->rn;
+    int toread = m->live ? 4096 : MFX_RBUF;
     int64_t remain = m->file_size - m->rbase;         /* never read past the window (CIA-embedded moflex) */
     if (remain < MFX_RBUF) toread = remain > 0 ? (int)remain : 0;
     size_t got = toread ? fread(m->rbuf, 1, (size_t)toread, m->f) : 0;
@@ -228,7 +230,28 @@ int mfx_open_window(MfxDemux *m, FILE *f, int64_t base, int64_t size) {
 
 int mfx_open(MfxDemux *m, FILE *f) { return mfx_open_window(m, f, 0, -1); }
 
+int mfx_open_live(MfxDemux *m, FILE *f) {
+    memset(m, 0, sizeof(*m));
+    m->f = f;
+    m->live = 1;
+    m->file_size = INT64_MAX; /* unknown and growing; io_feof observes actual stream close */
+    m->rbuf = (uint8_t *)malloc(MFX_RBUF);
+    if (!m->rbuf) return -1;
+    /* Parse descriptors from the first block. mfx_open_window() cannot be used:
+     * it probes the file tail and fseeko() is unsupported on a live HTTP body. */
+    if (moflex_read_sync(m) != 0) {
+        free(m->rbuf);
+        m->rbuf = NULL;
+        return -1;
+    }
+    /* First block fits in the 4096-byte buffered window, so this rewinds
+     * without attempting a physical seek on the input pipe. */
+    io_seek(m, 0, SEEK_SET);
+    return 0;
+}
+
 int mfx_seek_frac(MfxDemux *m, double frac) {
+    if (m->live) return -1;
     if (m->file_size <= 0) return -1;
     if (frac < 0) frac = 0;
     if (frac > 0.999) frac = 0.999;
@@ -263,6 +286,7 @@ int mfx_seek_frac(MfxDemux *m, double frac) {
 /* Seek to a target TIMESTAMP (microseconds). Binary-searches byte offsets so it
  * lands near the target regardless of the nonlinear byte<->time mapping. */
 int mfx_seek_time(MfxDemux *m, int64_t target_us) {
+    if (m->live) return -1;
     if (m->duration_us <= 0 || m->file_size <= 0) return mfx_seek_frac(m, 0);
     if (target_us <= 0) return mfx_seek_frac(m, 0);   /* seek-to-start: no binary search needed */
     if (target_us > m->duration_us) target_us = m->duration_us;
@@ -282,6 +306,7 @@ int mfx_seek_time(MfxDemux *m, int64_t target_us) {
  * frame per displayed instant); a 2D one delivers ~1x. Pre-scans ~2s of packets (demux only, no
  * decode) then rewinds to the start so playback is unaffected. Returns 1 = 3D, 0 = 2D. */
 int mfx_detect_stereo(MfxDemux *m) {
+    if (m->live) return 0; /* live mode cannot rewind a pre-scan */
     int vi = -1;
     for (int i = 0; i < m->nb_streams; i++)
         if (m->streams[i].media_type == MFX_TYPE_VIDEO && vi < 0) vi = i;
diff --git a/decoder/moflex_demux.h b/decoder/moflex_demux.h
--- a/decoder/moflex_demux.h
+++ b/decoder/moflex_demux.h
@@ -54,6 +54,7 @@ typedef struct {
     int      in_block;
 
     int64_t  file_size;     /* size of the moflex window (whole file, or the region inside a CIA) */
+    int      live;          /* forward-only stream: no file length, duration probe or seeking */
     int64_t  base;          /* byte offset of the moflex within the file (0 = plain .moflex) */
     int64_t  duration_us;   /* estimated total duration (microseconds) */
     int      tb_is_eye;     /* 3D: the declared timebase is the EYE-frame period (Nintendo files
@@ -66,6 +67,11 @@ typedef struct {
 /* Returns 0 on success. Parses the first sync so stream table is known. */
 int  mfx_open(MfxDemux *m, FILE *f);
 
+/* Experimental stream variant for our incremental MOFLEX muxer.
+ * Accepts a forward-only FILE* (such as an HTTP-body pipe), including one
+ * where ftello() fails. Caller must not invoke seek or pre-scan APIs. */
+int  mfx_open_live(MfxDemux *m, FILE *f);
+
 /* Like mfx_open but reads only the window [base, base+size) of the file -- used to play a moflex
  * embedded inside a (unencrypted) CIA in place. size < 0 = to end of file. */
 int  mfx_open_window(MfxDemux *m, FILE *f, int64_t base, int64_t size);
